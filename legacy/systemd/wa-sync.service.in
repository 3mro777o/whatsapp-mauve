[Unit]
Description=WhatsApp Archive — live sync (read-only linked device)
Documentation=file://@WA_HOME@/src/docs/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10
OnFailure=wa-sync-check.service

[Service]
Type=simple
WorkingDirectory=@WA_HOME@
Environment=WA_HOME=@WA_HOME@
Environment=PATH=@PATH@
ExecStart=@NODE@ @WA_HOME@/src/tools/wa-sync/sync.mjs
ExecStopPost=@WA_HOME@/src/tools/wa-sync-check --stopped
Restart=always
RestartSec=15
# keep the machine light
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryHigh=600M
MemoryMax=1G

[Install]
WantedBy=default.target
