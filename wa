#!/usr/bin/env bash
# wa - control whatsapp-mauve (one docker image, one self-contained folder per WhatsApp account under <repo>/profiles/).
# The profiles/ folder IS the registry: a profile = profiles/<name>/ with a wa.conf. Works through the ~/.local/bin symlink.
#   wa new <name> [--port N]                 create profiles/<name>/ (wa.conf + compose.yml), free ports picked automatically
#   wa list                                  profiles, ports, running state
#   wa up|down|restart|status|logs [name|all]   (no name = all) docker compose from the repo root
#   wa key <name>                            save the 64-digit E2E backup key (.wa_key, mode 600)
#   wa import <name> [PHONE_DIR]             phone WhatsApp folder -> decrypt msgstore + media (hardlink or copy)
#   wa link <name>                           link as a WhatsApp device (QR in the terminal)
#   wa pin <name> [--clear]                  viewer PIN lock
#   wa backup <name> <dest>                  copy the profile to <dest>/<name> (without cache/)
#   wa restore <dir> [--move]                copy (or move) a profile folder into profiles/ and regenerate
#   wa regen                                 regenerate every profiles/*/compose.yml + the root compose.yml include list
#   wa migrate-legacy <legacy_dir> <name> [--dry-run] [--phone DIR]   old non-docker layout -> profiles/<name>/
#   wa notify <name> | notify-on|notify-off <name>   host desktop notification when the link breaks
#   wa build | shell <name>
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PROFILES="$REPO/profiles"; ROOTCOMPOSE="$REPO/compose.yml"
export WA_IMAGE="whatsapp-mauve:local"
die() { echo "wa: $*" >&2; exit 1; }
say() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
cget() { local v; v="$(sed -n "s/^$2=//p" "$1/wa.conf" 2>/dev/null | tail -1 | sed 's/ #.*//; s/[[:space:]]*$//')"; echo "${v:-${3:-}}"; }
cset() {  # cset DIR KEY VALUE
  local v="${3//\\/\\\\}"; v="${v//&/\\&}"; v="${v//|/\\|}"
  if grep -q "^$2=" "$1/wa.conf"; then sed -i "s|^$2=.*|$2=$v|" "$1/wa.conf"; else echo "$2=$3" >> "$1/wa.conf"; fi
}
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "name: letters, digits, - and _ only"; }
names() { local f; for f in "$PROFILES"/*/wa.conf; do [ -f "$f" ] && basename "$(dirname "$f")"; done; return 0; }
pdir() { [ -f "$PROFILES/$1/wa.conf" ] || die "no profile '$1' (wa list; wa new $1)"; echo "$PROFILES/$1"; }
port_busy() {  # in use now, or claimed by a profile
  ss -ltn "sport = :$1" 2>/dev/null | grep -q LISTEN && return 0
  local n; for n in $(names); do
    [ "$(cget "$PROFILES/$n" WA_PORT)" = "$1" ] || [ "$(cget "$PROFILES/$n" WA_SYNC_PORT)" = "$1" ] && return 0
  done; return 1
}
listening() { ss -ltn "sport = :$1" 2>/dev/null | grep -q LISTEN; }
phone_of() { local d="$1" p; p="$(cget "$d" WA_PHONE_DIR)"; p="${p/#\~/$HOME}"; [ -n "$p" ] || return 0; [[ "$p" = /* ]] || p="$d/$p"; echo "$p"; }

gen() {  # gen NAME : profiles/NAME/compose.yml from its wa.conf (uid:gid of the current user baked in)
  local n="$1" d="$PROFILES/$1" rst ph vol
  [ "$(cget "$d" WA_VIEWER_AUTOSTART 0)" = 1 ] && rst=unless-stopped || rst=no
  vol='".:/data"'; ph="$(phone_of "$d")"
  if [ -n "$ph" ]; then
    if [ -d "$ph" ]; then vol="$vol, '${ph//\'/\'\'}:/phone:ro'"; else echo "wa: warning: $n: WA_PHONE_DIR $ph not found, not mounted" >&2; fi
  fi
  cat > "$d/compose.yml" <<EOF
# GENERATED by 'wa' from wa.conf (wa regen) - do not edit. uid:gid of the generating user is baked in: run 'wa regen' on a new machine.
x-app: &app
  image: whatsapp-mauve:local
  build: { context: ../../src, dockerfile: Dockerfile }
  network_mode: host            # keeps loopback / tailscale-serve semantics; ports come from wa.conf
  init: true
  cap_drop: [ALL]
  security_opt: ["no-new-privileges:true"]
  user: "$(id -u):$(id -g)"
  environment: [WA_HOME=/data, WA_PHONE_DIR=/phone, HOME=/tmp]
  volumes: [$vol]
  mem_limit: 1g
  cpu_shares: 128
services:
  $n-sync:                      # live sync: starts with docker at boot
    <<: *app
    command: [sync]
    restart: unless-stopped
  $n-viewer:                    # WA_VIEWER_AUTOSTART=1 in wa.conf -> unless-stopped
    <<: *app
    command: [viewer]
    restart: $rst
EOF
}
regen() {  # every profile compose + the root include list
  local n; for n in $(names); do gen "$n"; done
  {
    echo "# GENERATED by 'wa regen': includes every profiles/<name>/compose.yml. 'docker compose up -d' here starts ALL profiles;"
    echo "# 'docker compose up -d <name>-sync' / '<name>-viewer' starts one service."
    echo "name: whatsapp-mauve"
    if [ -z "$(names)" ]; then echo "services: {}   # no profiles yet: wa new <name>"; else
      echo "include:"
      for n in $(names); do echo "  - path: profiles/$n/compose.yml"; echo "    required: false"; done
    fi
  } > "$ROOTCOMPOSE"
}
dc() { docker compose --project-directory "$REPO" -f "$ROOTCOMPOSE" "$@"; }
svcs() {  # svcs NAME|all -> sets SV (array of service names; empty = whole project)
  SV=(); [ "${1:-all}" = all ] && return 0; pdir "$1" >/dev/null; SV=("$1-sync" "$1-viewer")
}
running() { docker ps --filter "label=com.docker.compose.project=whatsapp-mauve" --format '{{.Label "com.docker.compose.service"}}' 2>/dev/null; }
ts_serve() {  # ts_serve NAME on|off : optional `tailscale serve` https port from wa.conf (WA_TS_HTTPS)
  local d p; d="$(pdir "$1")"; p="$(cget "$d" WA_TS_HTTPS)"; [ -n "$p" ] || return 0
  command -v tailscale >/dev/null || { echo "wa: tailscale not installed, skipping WA_TS_HTTPS" >&2; return 0; }
  if [ "$2" = on ]; then tailscale serve --bg --https="$p" "http://127.0.0.1:$(cget "$d" WA_PORT 8777)" >/dev/null || echo "wa: tailscale serve failed" >&2
  else tailscale serve --https="$p" off >/dev/null 2>&1 || true; fi
}
conf_template() {  # conf_template NAME PORT > wa.conf text
  cat <<EOF
# whatsapp-mauve profile "$1". Everything about this account lives in this folder (paths are relative to it).
# After editing ports / WA_VIEWER_AUTOSTART / WA_PHONE_DIR run: wa regen   (wa up does it for you)
# --- network (per profile) ---
WA_PORT=$2                     # viewer
WA_SYNC_PORT=$(($2 + 1))                # send API of wa-sync (127.0.0.1 only)
WA_ACCESS=local                   # local | tailscale | lan (lan needs WA_PASSWORD)
WA_PASSWORD=
WA_TS_HTTPS=                      # optional: https port for 'tailscale serve' on the host (wa up/down manage it)
WA_VIEWER_AUTOSTART=0             # 1 = viewer container also restarts with docker at boot
WA_SESSION_DAYS=30
# --- phone WhatsApp folder (contains Media/ and Databases/); empty = none (mounted read-only at /phone) ---
WA_PHONE_DIR=
# --- layout (do not change unless you know why) ---
WA_DB=archive.db
WA_STORE=.
WA_MEDIA_DIR=media
WA_WEB=cache/web
WA_USER=user
WA_STATE=state
WA_AUTH=state/auth
WA_KEY_FILE=.wa_key
WA_SYSTEM_THEME=
# --- live sync ---
WA_MEDIA_MAX_MB=200
WA_DOWNLOAD_STATUS=1
WA_DEFAULT_CC=90
WA_UPLOAD_MAX_MB=100
WA_GIPHY_KEY=
WA_KLIPY_KEY=
EOF
}
free_port() { local p=8777; while port_busy "$p" || port_busy $((p + 1)); do p=$((p + 10)); done; echo "$p"; }

migrate_legacy() {
  local L="" N="" dry=0 phone=""
  while [ $# -gt 0 ]; do case "$1" in
    --dry-run) dry=1 ;; --phone) phone="${2:?}"; shift ;;
    *) if [ -z "$L" ]; then L="$1"; elif [ -z "$N" ]; then N="$1"; else die "unexpected argument $1"; fi ;;
  esac; shift; done
  [ -n "$L" ] && [ -n "$N" ] || die "usage: wa migrate-legacy <legacy_dir> <name> [--dry-run] [--phone DIR]"
  valid_name "$N"; L="$(cd "${L/#\~/$HOME}" && pwd)" || die "no such folder"
  local P="$PROFILES/$N"
  run() { if [ "$dry" = 1 ]; then printf '  [dry] %q' "$1"; shift; printf ' %q' "$@"; echo; else "$@"; fi; }
  say "migrate $L -> $P$([ "$dry" = 1 ] && echo '  (DRY RUN: nothing is changed)')"
  # --- refuse when the old services run ---
  local why=""
  systemctl --user is-active --quiet wa-sync 2>/dev/null && why="systemctl --user wa-sync is active; "
  systemctl --user is-active --quiet wa-archive 2>/dev/null && why="${why}wa-archive unit is active; "
  local lp sp; lp="$(cget "$L" WA_PORT 8777)"; sp="$(cget "$L" WA_SYNC_PORT 8778)"
  listening "$lp" && why="${why}port $lp busy; "; listening "$sp" && why="${why}port $sp busy; "
  if [ -n "$why" ]; then
    if [ "$dry" = 1 ]; then echo "  !! a real run would REFUSE: ${why%; } (stop the legacy services first)"; else die "legacy services are running: ${why%; }stop them first"; fi
  fi
  # --- sanity ---
  [ -f "$L/archive/archive.db" ] || die "$L/archive/archive.db not found"
  [ ! -e "$P/wa.conf" ] || die "$P already has a wa.conf"
  local d1 d2
  d1="$(stat -c %d "$L/archive")"; d2="$(stat -c %d "$REPO")"
  [ "$d1" = "$d2" ] || { if [ "$dry" = 1 ]; then echo "  !! a real run would REFUSE: $L and $PROFILES are on different filesystems (mv would copy tens of GB)"; else die "$L and $PROFILES are on different filesystems: refusing (mv needed)"; fi; }
  local store="$L/archive/store/Media"
  # --- plan ---
  echo "  legacy: db=$L/archive/archive.db  media=$store  user=$L/archive/web/user  thumbs=$L/archive/web/thumbs  state=$L/state"
  run mkdir -p "$P/state" "$P/media" "$P/user" "$P/cache/web/thumbs"; run chmod 700 "$P/state"
  local f
  for f in archive.db archive.db-wal archive.db-shm; do [ -e "$L/archive/$f" ] && run mv "$L/archive/$f" "$P/$f"; done
  if [ -d "$store" ]; then
    echo "  media: $(ls -A "$store" | wc -l) top-level entries of $store -> $P/media/ (mv)"
    for f in "$store"/* "$store"/.[!.]*; do [ -e "$f" ] && run mv "$f" "$P/media/"; done
  fi
  local udir="$L/archive/web/user"
  if [ -d "$udir" ]; then for f in "$udir"/* "$udir"/.[!.]*; do [ -e "$f" ] && run mv "$f" "$P/user/"; done; fi
  # state/*: everything except the project's own handoff notes, logs and stale backups
  for f in "$L"/state/* "$L"/state/.[!.]*; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in handoff|handoff-lock.md|user-backup-before-migration|*.log|msgstore.decrypted.db) echo "  skip state/$(basename "$f")"; continue ;; esac
    run mv "$f" "$P/state/"
  done
  [ -f "$L/.wa_key" ] && run mv "$L/.wa_key" "$P/.wa_key"
  [ -f "$L/contacts.vcf" ] && run mv "$L/contacts.vcf" "$P/state/contacts.vcf"
  # --- wa.conf: fresh template + carried-over settings ---
  local keys=(WA_ACCESS WA_PORT WA_SYNC_PORT WA_PASSWORD WA_VIEWER_AUTOSTART WA_SESSION_DAYS WA_TS_HTTPS WA_GIPHY_KEY WA_KLIPY_KEY WA_MEDIA_MAX_MB WA_DOWNLOAD_STATUS WA_DEFAULT_CC WA_UPLOAD_MAX_MB) k v
  if [ "$dry" = 1 ]; then echo "  wa.conf: new template, carrying over:"; else conf_template "$N" "$lp" > "$P/wa.conf"; chmod 600 "$P/wa.conf"; fi
  for k in "${keys[@]}"; do
    v="$(cget "$L" "$k")"; [ -n "$v" ] || continue
    case "$k" in WA_PASSWORD|WA_GIPHY_KEY|WA_KLIPY_KEY) echo "    $k=<set, hidden>" ;; *) echo "    $k=$v" ;; esac
    [ "$dry" = 1 ] || cset "$P" "$k" "$v"
  done
  [ -n "$phone" ] && { echo "    WA_PHONE_DIR=$phone"; [ "$dry" = 1 ] || cset "$P" WA_PHONE_DIR "$(readlink -f "${phone/#\~/$HOME}")"; }
  # --- database path rewrite + thumbs ---
  local dbfile="$P/archive.db" thumbs="$L/archive/web/thumbs"
  [ "$dry" = 1 ] && dbfile="$L/archive/archive.db"
  python3 - "$dbfile" "$dry" "$thumbs" "$P/cache/web/thumbs" <<'PY'
import hashlib, json, os, sqlite3, sys
db, dry, thumbs, newthumbs = sys.argv[1], sys.argv[2] == "1", sys.argv[3], sys.argv[4]
c = sqlite3.connect(f"file:{db}?mode=ro", uri=True) if dry else sqlite3.connect(db, timeout=60)
sha = lambda m: hashlib.sha1(m.encode("utf-8")).hexdigest() + ".jpg"
n_media = c.execute("select count(*) from media where substr(path,1,6)='Media/'").fetchone()[0]
n_jobs = c.execute("select count(*) from jobs where result like '%\"m\": \"Media/%'").fetchone()[0]
print(f"  SQL rows to rewrite  media.path: {n_media}   jobs.result: {n_jobs}")
rows = c.execute("select id, data from messages where data like '%\"m\": \"Media/%'").fetchall()
upd, moves = [], {}
for i, d in rows:
    j = json.loads(d)
    m = j.get("m")
    if not (isinstance(m, str) and m.startswith("Media/")):
        continue
    nm = "media/" + m[6:]
    p = j.get("p")
    if isinstance(p, str) and p == "thumbs/" + sha(m):
        j["p"] = "thumbs/" + sha(nm); moves[sha(m)] = sha(nm)
    j["m"] = nm
    upd.append((json.dumps(j, ensure_ascii=False), i))
print(f"  SQL rows to rewrite  messages.data ($.m and $.p): {len(upd)}   thumbnails to rename: {len(moves)}")
if dry:
    print(f"  thumbs dir: {thumbs}: {len(os.listdir(thumbs)) if os.path.isdir(thumbs) else 0} entries (waves.json / media-hash.json caches are dropped, regenerated)")
    sys.exit(0)
with c:
    c.execute("update media set path='media/'||substr(path,7) where substr(path,1,6)='Media/'")
    c.execute("update jobs set result=replace(result,'\"m\": \"Media/','\"m\": \"media/') where result like '%\"m\": \"Media/%'")
    c.executemany("update messages set data=? where id=?", upd)
c.execute("pragma wal_checkpoint(TRUNCATE)"); c.close()
print("  database rewritten")
if os.path.isdir(thumbs):
    for f in os.listdir(thumbs):
        src = os.path.join(thumbs, f)
        if f in ("waves.json", "media-hash.json"):
            continue
        if f in moves:
            os.replace(src, os.path.join(newthumbs, moves[f]))
        elif os.path.isdir(src):          # gif/ stk/: keyed by content hash, unchanged
            os.replace(src, os.path.join(newthumbs, f))
        elif f.endswith(".jpg") and f not in moves:
            os.replace(src, os.path.join(newthumbs, f))   # thumbs of files that kept no data.p: unreferenced but harmless
PY
  if [ "$dry" = 0 ]; then
    chmod 600 "$P/archive.db"* "$P/.wa_key" "$P/wa.conf" 2>/dev/null || true
    for f in api-token msg-secrets.jsonl viewer-pin viewer-sessions.json me.json contacts.vcf; do chmod 600 "$P/state/$f" 2>/dev/null || true; done
    chmod -R go-rwx "$P/state" 2>/dev/null || true
    regen; say "profile '$N' ready: $P  (wa up $N)"
    echo "note: set WA_PHONE_DIR in $P/wa.conf (or: wa import $N <phone dir>) before importing newer backups; wa regen after editing it."
  else
    echo "  then: wa regen (profile compose + root include)"; say "dry run done"
  fi
}

cmd="${1:-list}"; [ $# -gt 0 ] && shift
case "$cmd" in
  new)
    n="${1:?usage: wa new <name> [--port N]}"; shift; valid_name "$n"; port=""
    while [ $# -gt 0 ]; do case "$1" in --port) port="${2:?}"; shift 2 ;; *) die "unknown option $1" ;; esac; done
    d="$PROFILES/$n"; [ ! -e "$d/wa.conf" ] || die "profile '$n' already exists"
    [ -n "$port" ] || port="$(free_port)"
    mkdir -p "$d"/{state,media,user,cache}; chmod 700 "$d/state"
    conf_template "$n" "$port" > "$d/wa.conf"; chmod 600 "$d/wa.conf"; regen
    say "profile '$n' created in $d (viewer port $port)"
    echo "next: wa key $n   ·   wa import $n <phone WhatsApp folder>   ·   wa up $n   ·   wa link $n" ;;
  list)
    printf '%-14s %-6s %-10s %-9s %s\n' NAME PORT ACCESS RUNNING DIR; r="$(running)"
    for n in $(names); do d="$PROFILES/$n"
      printf '%-14s %-6s %-10s %-9s %s\n' "$n" "$(cget "$d" WA_PORT)" "$(cget "$d" WA_ACCESS local)" "$(grep -cxE "$n-(sync|viewer)" <<<"$r" || true)/2" "$d"
    done ;;
  regen) regen; say "regenerated: $(names | tr '\n' ' ')" ;;
  up)
    n="${1:-all}"; svcs "$n"; regen
    for t in $([ "$n" = all ] && names || echo "$n"); do d="$PROFILES/$t"   # host network: a busy port = crash loop
      if ! grep -qxE "$t-(sync|viewer)" <<<"$(running)"; then
        for k in WA_PORT WA_SYNC_PORT; do ! listening "$(cget "$d" $k)" || die "$t: $k=$(cget "$d" $k) is already in use on this machine (edit $d/wa.conf)"; done
      fi
    done
    dc up -d "${SV[@]}"
    for t in $([ "$n" = all ] && names || echo "$n"); do ts_serve "$t" on; say "$t: http://127.0.0.1:$(cget "$PROFILES/$t" WA_PORT)/"; done ;;
  down)
    n="${1:-all}"; svcs "$n"; for t in $([ "$n" = all ] && names || echo "$n"); do ts_serve "$t" off; done
    if [ "$n" = all ]; then dc down; else dc rm -sf "${SV[@]}"; fi ;;
  restart) svcs "${1:-all}"; regen; dc restart "${SV[@]}" ;;
  logs)    n="${1:-all}"; shift || true; svcs "$n"; dc logs -f --tail 50 "${SV[@]}" "$@" ;;
  status)
    n="${1:-all}"; svcs "$n"; dc ps "${SV[@]}"
    for t in $([ "$n" = all ] && names || echo "$n"); do
      python3 - "$PROFILES/$t/state/status.json" "$t" <<'PY' || echo "$t: no sync status yet (wa link $t)"
import json, sys, time
d = json.load(open(sys.argv[1]))
print(f"{sys.argv[2]} sync: {d.get('state')} {d.get('msg') or ''} (last {int(time.time() - d.get('last', 0))}s ago)")
PY
    done ;;
  key)
    d="$(pdir "${1:?name}")"
    read -rsp "64-digit backup key: " k; echo
    k="${k//[[:space:]]/}"; [[ "$k" =~ ^[0-9A-Fa-f]{64}$ ]] || die "the key must be exactly 64 hex digits (0-9, a-f); nothing saved"
    (umask 077; printf '%s\n' "$k" > "$d/.wa_key"); chmod 600 "$d/.wa_key"; say "key saved ($d/.wa_key, mode 600)" ;;
  import)
    n="${1:?usage: wa import <name> [PHONE_DIR]}"; d="$(pdir "$n")"
    if [ -n "${2:-}" ]; then pd="${2/#\~/$HOME}"; [ -d "$pd" ] || die "no such folder: $pd"; cset "$d" WA_PHONE_DIR "$(readlink -f "$pd")"; fi
    ph="$(phone_of "$d")"; [ -n "$ph" ] && [ -d "$ph" ] || die "phone folder not set/found: wa import $n <phone WhatsApp folder>"
    regen
    [ -d "$ph/Media" ] || echo "wa: note: $ph/Media not found (media skipped)" >&2
    say "media: $ph/Media -> $d/media (hardlink if same disk, else copy)"
    # on the host so that hardlinks work (containers cannot hardlink across mounts)
    WA_HOME="$d" WA_PHONE_DIR="$ph" python3 "$REPO/src/tools/import_msgstore.py" --mirror-only
    say "database: decrypt newest Databases/msgstore*.crypt15 and import"
    dc run --rm --no-deps -T "$n-sync" import --latest --no-mirror ;;
  link)
    n="${1:?name}"; pdir "$n" >/dev/null; regen; dc stop "$n-sync" >/dev/null 2>&1 || true
    dc run --rm --no-deps -it "$n-sync" link || true
    dc up -d "$n-sync" ;;
  pin)
    n="${1:?name}"; pdir "$n" >/dev/null; regen; dc run --rm --no-deps -it "$n-viewer" "$([ "${2:-}" = --clear ] && echo clearpin || echo pin)" ;;
  shell) n="${1:?name}"; pdir "$n" >/dev/null; regen; dc run --rm --no-deps -it --entrypoint /entrypoint.sh "$n-sync" shell ;;
  build) say "building $WA_IMAGE"; docker build -t "$WA_IMAGE" "$REPO/src" ;;
  backup)
    n="${1:?usage: wa backup <name> <dest>}"; dest="${2:?dest}"; d="$(pdir "$n")"; t="$dest/$n"; mkdir -p "$t"; chmod 700 "$t"
    say "copying $d -> $t (without cache/ and compose.yml; archive.db via sqlite backup)"
    if command -v rsync >/dev/null; then
      rsync -aH --exclude=/cache/ --exclude=/compose.yml --exclude='archive.db*' --exclude=/state/msgstore.decrypted.db "$d/" "$t/"
    else
      (cd "$d" && tar --exclude=./cache --exclude=./compose.yml --exclude='./archive.db*' --exclude=./state/msgstore.decrypted.db -cf - .) | tar -C "$t" -xpf -
    fi
    [ -f "$d/archive.db" ] && python3 - "$d/archive.db" "$t/archive.db" <<'PY'
import sqlite3, sys
s = sqlite3.connect(sys.argv[1]); d = sqlite3.connect(sys.argv[2]); s.backup(d); d.close(); s.close()
PY
    mkdir -p "$t/cache"; chmod 700 "$t"; chmod 600 "$t/archive.db" 2>/dev/null || true  # rsync -a copied the source dir mode
    echo "wa: WARNING: $t holds the WhatsApp login session (state/auth), the backup key (.wa_key) and every message: keep it private/encrypted." >&2
    echo "wa: do not run the restored copy while the original still runs (same session on two hosts = WhatsApp disconnects one)." >&2
    say "backup done: $t" ;;
  restore)
    src="${1:?usage: wa restore <profile dir> [--move]}"; mv_=0; [ "${2:-}" = --move ] && mv_=1
    src="$(cd "$src" && pwd)"; [ -f "$src/wa.conf" ] || die "$src has no wa.conf"
    n="$(basename "$src")"; valid_name "$n"; d="$PROFILES/$n"
    if [ "$src" != "$d" ]; then
      [ ! -e "$d" ] || die "profiles/$n already exists"
      mkdir -p "$PROFILES"
      if [ "$mv_" = 1 ]; then mv "$src" "$d"; else say "copying $src -> $d"; cp -a "$src" "$d"; fi
    fi
    mkdir -p "$d"/{state,media,user,cache}; chmod 700 "$d/state"; rm -f "$d/compose.yml"; regen
    busy=0; for k in WA_PORT WA_SYNC_PORT; do
      if listening "$(cget "$d" $k)"; then busy=1; echo "wa: warning: $k=$(cget "$d" $k) is in use on this machine; edit $d/wa.conf" >&2; fi
    done
    say "profile '$n' restored (uid:gid $(id -u):$(id -g) baked in; if the files came from another uid: sudo chown -R $(id -u):$(id -g) $d)"
    [ "$busy" = 0 ] || { echo "wa: not started (port in use). Fix the ports, then: wa up $n" >&2; exit 0; }
    dc up -d "$n-sync" "$n-viewer"; ts_serve "$n" on ;;
  migrate-legacy) migrate_legacy "$@" ;;
  notify)
    d="$(pdir "${1:?name}")"; mark="${XDG_RUNTIME_DIR:-/tmp}/wa-notify-$1"
    s="$(python3 - "$d/state/status.json" <<'PY' 2>/dev/null || echo missing
import json, sys, time
d = json.load(open(sys.argv[1])); st = d.get("state")
print("stale" if st == "connected" and time.time() - d.get("last", 0) > 150 else st)
PY
)"
    case "$s" in connected|starting|connecting) rm -f "$mark"; exit 0 ;; esac
    [ "$(cat "$mark" 2>/dev/null)" = "$s" ] && exit 0; echo "$s" > "$mark"
    notify-send -a "WhatsApp Archive" -u critical -i dialog-warning "WhatsApp Archive: $1" \
      "sync is not running ($s). wa status $1 ; wa link $1" 2>/dev/null || true ;;
  notify-on)
    n="${1:?name}"; pdir "$n" >/dev/null; u="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"; mkdir -p "$u"
    cp "$REPO"/src/docker/wa-notify@.service "$REPO"/src/docker/wa-notify@.timer "$u/"
    systemctl --user daemon-reload; systemctl --user enable --now "wa-notify@$n.timer"; say "notifier on for '$n' (every 10 min)" ;;
  notify-off) systemctl --user disable --now "wa-notify@${1:?name}.timer" ;;
  *) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
