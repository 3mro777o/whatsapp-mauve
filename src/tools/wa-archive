#!/usr/bin/env python3
"""Serve the WhatsApp archive viewer on http://127.0.0.1:8777 (with HTTP Range for media seeking).

JSON API (same-origin; clients limited by WA_ACCESS):
  GET    /api/bookmarks          -> [...]            (archive/web/user/bookmarks.json)
  PUT    /api/bookmarks  [...]   -> {"ok":true}      (atomic write + bookmarks.json.bak)
  GET    /api/avatars            -> {"<chatId>": "user/avatars/<file>?v=<mtime>"}
  POST   /api/avatar/<chatId>    raw image body -> {"ok":true,"url":...}
  DELETE /api/avatar/<chatId>    -> {"ok":true}
  GET    /api/people             -> {"nicknames":{"<j>":"..."},"groups":[{"id","name","color","members":["<j>"]}]}
  PUT    /api/people   {...}     -> {"ok":true}      (validated, atomic write + people.json.bak)
  POST   /api/read {chat} -> {"ok":true,"u":0}   local unread reset + best-effort markChatAsRead on WhatsApp via wa-sync /read (never a read receipt; no PIN needed beyond the gate)
  GET    /api/changes?since=<seq> -> {"seq":n,"chats":["<chatId>",…]}   ("*" = names/ids changed: reload list)
  GET    /api/sync/status        -> {"state":"connected|connecting|disconnected|logged_out|stopped","last":ts,"pending":n,…}
  GET    /api/media/pending      -> [{"chat","chatName","key","kind","name","sz","t","expires","state","progress"}]
  POST   /api/media/fetch/<chatId>/<keyId> -> {"ok":true,"m":path} | {"ok":true,"state":"queued|downloading"} | {"ok":false,"error":"unavailable"}
  POST   /api/media/skip/<chatId>/<keyId>  -> {"ok":true}
  GET    /api/members/<chatId>   -> [{"j","n","admin","active","chat"}]
  GET    /api/theme              -> {"name","mode","mtime","colors":{key:"#hex"}} | 404 (WA_SYSTEM_THEME)
  GET    /api/legacy-ids         -> {"<old chat id>": "<new chat id>"}
  POST   /api/login {"pin"}      -> {"ok":true} + cookie wa_s   (PIN lock; POST /api/logout clears the session)
  GET    /api/lock               -> {"pin":bool}                (is a PIN set)
  POST   /api/upload  raw body (X-Name urlencoded, Content-Type) -> {"ok":true,"id"}   (sending: PIN set or WA_ACCESS=local)
  POST   /api/send    {"chat","type","text"?,"upload"?|"lib"?|"giphy":{"id","kind"}?|"from":{"chat","idx"}?,
                       "reply"?:{"chat","idx"}|{"key_id","from_me","sender"},"dry"?} -> {"ok":true,"key_id"}
                      type text|image|video|document|ptt|audio|sticker|gif; sent by tools/wa-sync (tools/sender.py)
  GET    /api/stickers|gifs?offset=0&limit=60 -> {"fav":[item],"recent":[item],"items":[item],"next":offset|null,"total":n}
                      item = {"id":"l:<id>"|"a:<sha16>","url","poster"? (gifs),"fav","last"}; fav/recent only at offset 0; deduped by sha256
                      (without offset/limit: the old {"saved":[...],"archive":[...]} shape)
  POST   /api/purge   {"items":[{"chat","key_id"}|{"chat","idx"}],"media"?,"dry"?} -> {"ok","removed","files","missing"}  (needs PIN; tombstoned)
  GET    /api/chatperm/<chatId> -> {"admin":bool,"me_jid"}   am I an admin of this group
  GET    /emoji.json     -> [{"g":group,"e":[emoji]}]  (tools/web-static/emoji.json)
  POST   /api/stickers|gifs/save  {"upload"|"giphy":{"id","kind"}|"chat"+"key"|"path"} -> {"ok":true,"id"}
  POST   /api/stickers|gifs/fav   {"id","fav"} -> {"ok":true,"id":"l:<id>"}   /used {"id"} -> same   (id may be an "a:<sha16>" archive item: saved first)
  POST   /api/delete  {"chat"?,"idx"?,"key_id"?,"scope":"me"|"everyone","dry"?} -> {"ok":true,"scope","key_id"}   (needs PIN like /api/send)
  POST   /api/react   {"chat"?,"idx"?,"key_id"?,"emoji" ("" removes),"dry"?} -> {"ok":true,"key_id","emoji"}   (needs PIN)
                      both find the message by key_id (preferred) or chat+idx; send type "forward": {"chat" (target),"from":{key_id|chat+idx}}
  GET    /api/me         -> {"jid","j","name","avatar":"/user/avatars/<j>.jpg?v=<mtime>"|null}
  GET    /api/avatar-history/<chatId> -> [{"url","ts"}] newest first (the current picture excluded)
  POST   /api/stickers|gifs/remove {"id"} -> {"ok":true}
  GET    /api/emoji -> {"fav":[e],"recent":[e]}   POST /api/emoji/used {"e"}   POST /api/emoji/fav {"e","fav"}  (user/emoji.json)
  GET    /api/gifsearch?q=&kind=gifs|stickers&offset=0&limit=25 -> {"items":[{"id":"giphy:<id>"|"klipy:<id>","preview","mp4"|"webp","w","h"}],"next":offset|null,"providers":[..]}
                      every provider with a key (WA_GIPHY_KEY, WA_KLIPY_KEY), merged; no key at all -> 503 "no key"; keys stay on the server
  GET    /api/giphy?q=&kind=gifs|stickers&offset=&limit=(max 50)  -> GIPHY JSON (the old route, kept)

PIN lock: `wa-archive --set-pin` / `--clear-pin` (tools/viewer_lock.py). With a PIN, every path needs the
wa_s session cookie (or header X-WA-Token = state/api-token, for background tools), except /login, /manifest.webmanifest
and /icons/<file> (the login page shows the app icon). Without a PIN, nothing changes.

/data/{chats,search,media,people}.json and /data/c/<id>.json are generated from archive.db (cached in
memory, refreshed from the `changes` feed). Without archive.db the static files under data/ are served.
"""
import base64, gzip, hmac, http.server, ipaddress, json, os, re, shutil, socket, subprocess, sys, threading, time, urllib.parse, webbrowser
