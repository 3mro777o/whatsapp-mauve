API_TOKEN = viewer_lock.api_token()  # for tools/avatar-fetcher (header X-WA-Token), state/api-token


def write_json_atomic(path, data):
    with _lock:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path): shutil.copy2(path, path + ".bak")
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=1)
            f.flush(); os.fsync(f.fileno())
        os.replace(tmp, path)


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f: return json.load(f)
    except (FileNotFoundError, ValueError): return default


KEY_RE = re.compile(r"[A-Za-z0-9_\-]{1,64}")
COLOR_RE = re.compile(r"#[0-9a-fA-F]{3,8}")


def validate_people(d):
    """Return an error string, or None if d matches the people.json shape."""
    if not isinstance(d, dict): return "expected an object"
    extra = set(d) - {"nicknames", "groups"}
    if extra: return f"unknown keys: {sorted(extra)}"
    nn = d.get("nicknames", {})
    if not isinstance(nn, dict): return "nicknames must be an object"
    if len(nn) > 20000: return "too many nicknames"
    for k, v in nn.items():
        if not KEY_RE.fullmatch(k): return f"bad nickname key {k!r}"
        if not isinstance(v, str) or len(v) > 200: return f"nickname for {k} must be a string <= 200"
    gs = d.get("groups", [])
    if not isinstance(gs, list): return "groups must be an array"
    if len(gs) > 500: return "too many groups (max 500)"
    ids = set()
    for i, g in enumerate(gs):
        if not isinstance(g, dict): return f"groups[{i}] must be an object"
        if set(g) - {"id", "name", "color", "members"}: return f"groups[{i}] has unknown keys"
        for f in ("id", "name", "color"):
            if not isinstance(g.get(f), str) or len(g[f]) > 200: return f"groups[{i}].{f} must be a string <= 200"
        if not g["id"] or g["id"] in ids: return f"groups[{i}].id missing or duplicate"
        ids.add(g["id"])
        if g["color"] and not COLOR_RE.fullmatch(g["color"]): return f"groups[{i}].color must be #hex"
        ms = g.get("members")
        if not isinstance(ms, list) or len(ms) > 5000: return f"groups[{i}].members must be an array"
        if not all(isinstance(m, str) and KEY_RE.fullmatch(m) for m in ms): return f"groups[{i}].members must be number strings"
    return None


def sync_status():
    st = read_json(STATUS_FILE, {})
    out = {"state": st.get("state", "stopped"), "last": st.get("last"), "since": st.get("since"),
           "msg": st.get("msg"), "me": st.get("me")}
    if out["state"] == "connected" and (not out["last"] or time.time() - out["last"] > 150):
        out["state"] = "disconnected"  # heartbeat stale: service not running
        out["msg"] = out["msg"] or "no heartbeat"
    if VD:
        out["pending"] = VD.db().execute(
            "select count(*) from media where state in ('pending','queued','downloading','failed')").fetchone()[0]
    else:
        out["pending"] = 0
    return out


def wdb():
    """Short-lived write connection (jobs / skip)."""
    return archive_db.connect(waconf.DB)


def media_lookup(cid, key):
    db = VD.db()
    m = db.execute("select * from messages where chat_id=? and key_id=? order by from_me desc limit 1", (cid, key)).fetchone()
    if m is None:
        ren = db.execute("select new from chat_renames where old=?", (cid,)).fetchone()
        if ren:
            m = db.execute("select * from messages where chat_id=? and key_id=? limit 1", (ren[0], key)).fetchone()
    if m is None:
        return None, None
    return m, db.execute("select * from media where msg_id=?", (m["id"],)).fetchone()


def pending_list():
    db = VD.db()
    rows = db.execute("""select md.*, m.chat_id, m.key_id, m.ts, m.kind mkind, m.data from media md
                         join messages m on m.id = md.msg_id
                         where md.state in ('pending','queued','downloading','failed') order by m.ts desc limit 500""").fetchall()
    out = []
    names = {}
    for r in rows:
        d = json.loads(r["data"]) if r["data"] else {}
        info = json.loads(r["info"]) if r["info"] else {}
        if r["chat_id"] not in names:
            c = db.execute("select * from chats where id=?", (r["chat_id"],)).fetchone()
            VD.refresh()
            names[r["chat_id"]] = VD.chat_name(c) if c else r["chat_id"]
        out.append({"chat": r["chat_id"], "chatName": names[r["chat_id"]], "key": r["key_id"],
                    "kind": r["kind"] or r["mkind"], "name": r["name"] or d.get("n") or "", "sz": r["size"],
                    "t": r["ts"], "expires": info.get("expires"), "state": r["state"],
                    "progress": r["progress"], **({"error": r["error"]} if r["error"] else {})})
    return out


class H(http.server.SimpleHTTPRequestHandler):
    _denied = False  # True once the PIN lock has answered the request
    def __init__(self, *a, **k): super().__init__(*a, directory=ROOT, **k)
    def log_message(self, *a): pass

    def parse_request(self):
        if not super().parse_request(): return False
        ip = self.client_address[0]
        if not is_allowed(ip):
            self.send_error(403, "forbidden"); return False
        if PASSWORD and not is_loopback(ip):
            got = self.headers.get("Authorization", "")
            want = "Basic " + base64.b64encode(f"wa:{PASSWORD}".encode()).decode()
            if not hmac.compare_digest(got, want):
                self.send_response(401)
                self.send_header("WWW-Authenticate", 'Basic realm="WhatsApp Archive", charset="UTF-8"')
                self.send_header("Content-Length", "0")
                self.end_headers(); return False
        return self._lock_ok()

    def send_response(self, code, message=None):
        self._code = code
        super().send_response(code, message)

    def end_headers(self):
        self.path = getattr(self, "path", "")  # unset when the request line itself was malformed
        if not self._denied and getattr(self, "_code", 0) in (200, 206, 304) and IMMUTABLE.fullmatch(self.path.split("?", 1)[0]):
            self.send_header("Cache-Control", "private, max-age=604800, immutable")
        elif self._denied or self.path.startswith("/api/") or self.path.startswith("/user/"):
            self.send_header("Cache-Control", "no-store")
        elif self.path.startswith("/data/"):
            self.send_header("Cache-Control", "private, no-cache")
        elif self.path.split("?", 1)[0] in ("/", "/index.html", "/sw.js", "/manifest.webmanifest"):
            self.send_header("Cache-Control", "no-cache")
        elif self.path.split("?", 1)[0] == "/emoji.json":
            self.send_header("Cache-Control", "private, max-age=86400")
        elif self.path.startswith(LONG_CACHE) and getattr(self, "_code", 0) in (200, 206, 304):  # a 404 must not be cached
            self.send_header("Cache-Control", "private, max-age=86400")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy", LOGIN_CSP if self.path.split("?", 1)[0] == "/login" else "frame-ancestors 'none'")
        super().end_headers()

    # ---------- PIN lock (tools/viewer_lock.py) ----------
    def _lock_ok(self):
        """True if the request may go on; otherwise the refusal has already been sent."""
        p = self.path.split("?", 1)[0]
        if not viewer_lock.pin_set() or p in PUBLIC or PUBLIC_ICON.fullmatch(p): return True
        tok = self.headers.get("X-WA-Token", "")
        if tok and hmac.compare_digest(tok.encode(), API_TOKEN.encode()): return True  # background tools
        if viewer_lock.session_ok(viewer_lock.cookie_token(self.headers.get("Cookie"))): return True
        self._denied = self.close_connection = True  # any request body is not read, so drop the connection
        if p in ("/", "/index.html") or "text/html" in self.headers.get("Accept", ""):
            self.send_response(302); self.send_header("Location", "/login"); self.send_header("Content-Length", "0")
            self.end_headers()
        else:
            self._err(401, "login required")
        return False

    def _login(self):
        raw = self._body(limit=1024)
        if raw is None: return
        try: pin = json.loads(raw)["pin"]
        except Exception: pin = None
        if not isinstance(pin, str): return self._err(400, "pin required")
        ip = client_key(self.client_address[0], self.headers)
        with viewer_lock.login_mu:  # check + verify + record atomically (else N parallel guesses all pass the throttle)
            wait = max(viewer_lock.wait_left(ip), viewer_lock.wait_left(viewer_lock.GLOBAL))
            if wait:
                secs = int(wait) + 1
                return self._json({"ok": False, "error": "locked", "wait": secs}, 429, [("Retry-After", str(secs))])
            ok = viewer_lock.check_pin(pin, viewer_lock.stored_pin())
            viewer_lock.record(ip, ok); viewer_lock.record(viewer_lock.GLOBAL, ok)
        if not ok: return self._err(401, "wrong pin")
        tok = viewer_lock.new_session()
        self._json({"ok": True}, extra=[("Set-Cookie", viewer_lock.set_cookie(tok, viewer_lock.SESSION_SECS, is_https(self.headers)))])

    def _logout(self):
        tok = viewer_lock.cookie_token(self.headers.get("Cookie"))
        if tok: viewer_lock.drop_session(tok)
        self._json({"ok": True}, extra=[("Set-Cookie", viewer_lock.set_cookie("", 0, is_https(self.headers)))])

    def _login_page(self):
        with open(os.path.join(waconf.TOOLS, "login.html"), "rb") as f: body = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-WA-Login", "1")  # the service worker never caches this page
        self.end_headers()
        self.wfile.write(body)

    # ---------- API ----------
    def _json(self, obj, code=200, extra=()):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        for k, v in extra: self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _err(self, code, msg): self._json({"ok": False, "error": msg}, code)

    def _allowed(self):
        if not is_allowed(self.client_address[0]):
            self._err(403, "forbidden"); return False
        # writes only from pages served by this server (same origin), so other websites can't touch the data
        origin = self.headers.get("Origin")
        if origin and re.sub(r"^https?://", "", origin) != self.headers.get("Host", ""):
            self._err(403, "bad origin"); return False
        return True

    def _body(self, limit=MAX_BODY):
        try: n = int(self.headers.get("Content-Length") or 0)
        except ValueError: n = -1
        if n < 0: self._err(411, "length required"); return None
        if n > limit:
            self.close_connection = True
            self._err(413, "body too large"); return None
        return self.rfile.read(n)

    def _api(self, method):
        if not self._allowed(): return
        p = self.path.split("?", 1)[0].rstrip("/")
        m = re.fullmatch(r"/api/avatar/([^/]+)", p)
        try:
            if p == "/api/logout" and method == "POST": return self._logout()
            if p == "/api/login" and method == "POST" and viewer_lock.pin_set(): return self._login()
            if p == "/api/lock" and method == "GET": return self._json({"pin": viewer_lock.pin_set()})
            if p == "/api/bookmarks" and method == "GET":
                try:
                    with open(BOOKMARKS, encoding="utf-8") as f: data = json.load(f)
                except FileNotFoundError: data = []
                return self._json(data if isinstance(data, list) else [])
            if p == "/api/bookmarks" and method == "PUT":
                raw = self._body()
                if raw is None: return
                try: data = json.loads(raw.decode("utf-8"))
                except Exception: return self._err(400, "invalid JSON")
                if not isinstance(data, list): return self._err(400, "expected a JSON array")
                write_json_atomic(BOOKMARKS, data)
                return self._json({"ok": True})
            if p == "/api/people" and method == "GET":
                d = read_json(PEOPLE, {})
                if not isinstance(d, dict): d = {}
                return self._json({"nicknames": d.get("nicknames") or {}, "groups": d.get("groups") or []})
            if p == "/api/people" and method == "PUT":
                raw = self._body()
                if raw is None: return
                try: data = json.loads(raw.decode("utf-8"))
                except Exception: return self._err(400, "invalid JSON")
                err = validate_people(data)
                if err: return self._err(400, err)
                write_json_atomic(PEOPLE, {"nicknames": data.get("nicknames", {}), "groups": data.get("groups", [])})
                return self._json({"ok": True})
            if p == "/api/changes" and method == "GET":
                if not VD:
                    import viewer_data as _vd
                    return self._json({"seq": 0, "chats": [], "theme": _vd.theme_mtime()})
                q = self.path.split("?", 1)[1] if "?" in self.path else ""
                mm = re.search(r"(?:^|&)since=(\d+)", q)
                return self._json(VD.changes(int(mm.group(1)) if mm else None))
            if p == "/api/theme" and method == "GET":
                import viewer_data as _vd
                t = _vd.theme()
                return self._json(t) if t else self._err(404, "no system theme")
            if p == "/api/legacy-ids" and method == "GET":
                # old static-build chat ids (msgstore chat._id) -> stable ids, plus lid->phone renames
                m = read_json(os.path.join(waconf.STATE, "chat-id-map.json"), {})
                if VD:
                    m.update({r[0]: r[1] for r in VD.db().execute("select old, new from chat_renames")})
                return self._json(m)
            if p == "/api/sync/status" and method == "GET":
                return self._json(sync_status())
            if p == "/api/media/pending" and method == "GET":
                return self._json(pending_list() if VD else [])
            if p == "/api/upload" and method == "POST": return self._upload()
            if p == "/api/send" and method == "POST": return self._send()
            if p == "/api/giphy" and method == "GET": return self._giphy(sender.giphy_search)
            if p == "/api/gifsearch" and method == "GET": return self._giphy(sender.gif_search)
            if p == "/api/delete" and method == "POST": return self._msg_action(sender.delete_msg)
            if p == "/api/react" and method == "POST": return self._msg_action(sender.react_msg)
            if p == "/api/purge" and method == "POST": return self._msg_action(self._purge)
            if p == "/api/me" and method == "GET": return self._me()
            if p == "/api/read" and method == "POST": return self._read()
            mm = re.fullmatch(r"/api/chatperm/([A-Za-z0-9_-]{1,64})", p)
            if mm and method == "GET": return self._run(sender.chat_perm, mm.group(1))
            if p == "/api/emoji" and method == "GET": return self._json(sender.emoji_overview())
            mm = re.fullmatch(r"/api/emoji/(used|fav)", p)
            if mm and method == "POST":
                body = self._json_body(limit=4096)
                return None if body is None else self._run(sender.emoji_set, body, mm.group(1))
            mm = re.fullmatch(r"/api/avatar-history/([A-Za-z0-9_-]{1,64})", p)
            if mm and method == "GET": return self._json(av.history(mm.group(1)))
            mm = re.fullmatch(r"/api/(stickers|gifs)(?:/(save|fav|used|remove))?", p)
            if mm and method == ("GET" if mm.group(2) is None else "POST"): return self._library(*mm.groups())
            mm = re.fullmatch(r"/api/media/(fetch|skip)/([A-Za-z0-9_-]{1,64})/([A-Za-z0-9_.:-]{1,128})", p)
            if mm and method == "POST":
                if not VD: return self._err(404, "no archive.db")
                action, cid, key = mm.groups()
                msg, md = media_lookup(cid, key)
                if msg is None: return self._err(404, "message not found")
                d = json.loads(msg["data"]) if msg["data"] else {}
                if action == "skip":
                    if md is not None:
                        db = wdb(); db.execute("update media set state='skipped', updated=? where msg_id=?", (int(time.time()), msg["id"]))
                        db.execute("insert into changes (chat_id, ts) values (?,?)", (msg["chat_id"], int(time.time()))); db.commit(); db.close()
                    return self._json({"ok": True})
                if d.get("m") and os.path.exists(os.path.join(waconf.STORE, d["m"])):
                    return self._json({"ok": True, "m": d["m"]})
                if md is None or not md["info"]:
                    return self._err(410, "unavailable")
                db = wdb()
                if md["state"] not in ("queued", "downloading"):
                    db.execute("update media set state='queued', progress=0, error=null, updated=? where msg_id=?", (int(time.time()), msg["id"]))
                    db.execute("insert into jobs (kind, arg, state, created, updated) values ('media', ?, 'queued', ?, ?)",
                               (str(msg["id"]), int(time.time()), int(time.time())))
                    db.execute("insert into changes (chat_id, ts) values (?,?)", (msg["chat_id"], int(time.time())))
                    db.commit()
                db.close()
                # wait a little: small files usually finish quickly
                deadline = time.time() + 20
                while time.time() < deadline:
                    time.sleep(0.5)
                    r = VD.db().execute("select state, path, error from media where msg_id=?", (msg["id"],)).fetchone()
                    if r["state"] == "done" and r["path"]:
                        return self._json({"ok": True, "m": r["path"]})
                    if r["state"] == "failed":
                        return self._json({"ok": False, "error": r["error"] or "failed"}, 502)
                st = sync_status()["state"]
                return self._json({"ok": True, "state": r["state"], **({"sync": st} if st != "connected" else {})})
            mm = re.fullmatch(r"/api/members/([A-Za-z0-9_-]{1,64})", p)
            if mm and method == "GET":
                return self._json(VD.members(mm.group(1)) if VD else [])
            if p == "/api/avatars" and method == "GET":
                return self._json(av.list_avatars())
            if m and method in ("POST", "PUT"):
                cid = m.group(1)
                if not av.valid_id(cid): return self._err(400, "invalid chat id")
                raw = self._body()
                if raw is None: return
                with _lock:
                    try: url = av.save_avatar(cid, raw)
                    except ValueError as e: return self._err(400, str(e))
                return self._json({"ok": True, "url": url})
            if m and method == "DELETE":
                cid = m.group(1)
                if not av.valid_id(cid): return self._err(400, "invalid chat id")
                with _lock: av.remove_avatar(cid)
                return self._json({"ok": True})
            return self._err(404 if method == "GET" else 405, "not found")
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as e:
            self._err(500, f"{type(e).__name__}: {e}")

    # ---------- sending, sticker/GIF library, GIPHY (tools/sender.py) ----------
    def _can_send(self):
        if viewer_lock.pin_set(): return True
        # no PIN: this machine only, and only under a loopback Host name (a rebound DNS name would otherwise pass the Origin check)
        if ACCESS == "local" and re.fullmatch(r"(127\.0\.0\.1|localhost|\[::1\])(:\d+)?", self.headers.get("Host", "").lower()): return True
        self.close_connection = True  # a request body, if any, is not read
        self._err(403, "set a PIN first"); return False

    def _json_body(self, limit=1 << 20):
        raw = self._body(limit=limit)
        if raw is None: return None
        try: d = json.loads(raw.decode("utf-8"))
        except ValueError: self._err(400, "invalid JSON"); return None
        if not isinstance(d, dict): self._err(400, "expected a JSON object"); return None
        return d

    def _run(self, fn, *a, **kw):
        try: res = fn(*a, **kw)
        except sender.Err as e: return self._err(e.code, str(e))
        self._json(res)

    def _upload(self):
        if not self._can_send(): return
        try: n = int(self.headers.get("Content-Length") or -1)
        except ValueError: n = -1
        if n < 0: return self._err(411, "length required")
        if n == 0: return self._err(400, "empty file")
        if n > sender.UPLOAD_MAX:
            self.close_connection = True
            return self._err(413, f"file too large (max {waconf.get('WA_UPLOAD_MAX_MB', int)} MB)")
        try: uid = sender.save_upload(self.rfile, n, self.headers.get("X-Name", ""), self.headers.get("Content-Type", ""))
        except BaseException as e:
            self.close_connection = True  # the body may be half read
            if isinstance(e, sender.Err): return self._err(e.code, str(e))
            raise
        self._json({"ok": True, "id": uid})

    def _send(self):
        if not self._can_send(): return
        body = self._json_body()
        if body is not None: self._run(sender.send, body)

    def _msg_action(self, fn):
        if not self._can_send(): return
        body = self._json_body(limit=65536)
        if body is not None: self._run(fn, body)

    @staticmethod
    def _purge(body):
        res = sender.purge(body)
        if VD and not res.get("dry"):
            VD.last_check = 0  # the changes entry is picked up right now, not up to a second later
            VD.refresh()
        return res

    def _read(self):
        body = self._json_body(limit=4096)
        if body is None: return
        self._run(self._mark_read, body)

    @staticmethod
    def _mark_read(body):
        res = sender.mark_read(body)
        if VD:
            VD.last_check = 0
            VD.refresh()
        return res

    def _me(self):
        me = sender._me()
        if not me: return self._json({"jid": None, "j": None, "name": "", "avatar": None})
        f = av.current_file(me["j"]) if av._safe_key(me["j"]) else None
        self._json({**me, "avatar": "/" + av.avatar_url(f) if f else None})

    def _giphy(self, search):  # GIF/sticker search proxy: the provider keys never leave the server
        if not self._can_send(): return
        q = urllib.parse.parse_qs(self.path.split("?", 1)[1]) if "?" in self.path else {}
        try: offset = min(5000, max(0, int((q.get("offset") or ["0"])[0])))
        except ValueError: return self._err(400, "bad offset")
        try: limit = min(50, max(1, int((q.get("limit") or ["25"])[0])))
        except ValueError: return self._err(400, "bad limit")
        self._run(search, (q.get("kind") or ["gifs"])[0], (q.get("q") or [""])[0][:100], offset, limit)

    def _library(self, kind, action):
        if action is None:
            q = urllib.parse.parse_qs(self.path.split("?", 1)[1]) if "?" in self.path else {}
            if "offset" not in q and "limit" not in q: return self._run(sender.lib_overview, kind)
            try: offset, limit = max(0, int((q.get("offset") or ["0"])[0])), min(200, max(1, int((q.get("limit") or ["60"])[0])))
            except ValueError: return self._err(400, "bad offset/limit")
            return self._run(sender.lib_page, kind, offset, limit)
        body = self._json_body(limit=65536)
        if body is None: return
        if action == "save":
            if body.get("giphy") and not self._can_send(): return  # a GIPHY download counts as sending
            return self._run(sender.lib_save, kind, body)
        if action == "remove": return self._run(sender.lib_remove, kind, body.get("id"))
        if action == "fav": return self._run(sender.lib_set, kind, body.get("id"), fav=bool(body.get("fav")))
        return self._run(sender.lib_set, kind, body.get("id"), last=int(time.time()))  # used

    def _data(self):
        """Dynamic /data/*.json from archive.db."""
        p = self.path.split("?", 1)[0]
        mm = re.fullmatch(r"/data/(chats|search|media|people)\.json", p) or re.fullmatch(r"/data/(c/[A-Za-z0-9_-]{1,64})\.json", p)
        if not mm:
            self.send_error(404); return
        body = VD.get(mm.group(1))
        if body is None:
            self.send_error(404); return
        etag = f'"{VD.seq}-{len(body)}-{hash(body) & 0xffffffff:x}"'
        if self.headers.get("If-None-Match") == etag:
            self.send_response(304); self.send_header("ETag", etag); self.end_headers(); return
        if "gzip" in (self.headers.get("Accept-Encoding") or "") and len(body) > 2048:
            key = (mm.group(1), etag)
            z = _gz.get(key)
            if z is None:
                z = gzip.compress(body, 5)
                if len(_gz) > 64: _gz.clear()
                _gz[key] = z
            body = z
            enc = True
        else:
            enc = False
        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        if enc: self.send_header("Content-Encoding", "gzip")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("ETag", etag)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def translate_path(self, path):
        # the UI and fonts come straight from tools/ (no build step needed after frontend edits)
        p = path.split("?", 1)[0]
        if p in ("/", "/index.html"):
            return os.path.join(waconf.TOOLS, "viewer.html")
        if p.startswith("/fonts/"):
            f = os.path.join(waconf.TOOLS, "fonts", os.path.basename(p))
            if os.path.isfile(f): return f
        if p in ("/manifest.webmanifest", "/sw.js", "/emoji.json") or p.startswith("/icons/"):  # PWA shell files; never fall back to the archive root
            return os.path.join(waconf.TOOLS, "web-static", p.lstrip("/").replace("..", ""))
        return super().translate_path(path)

    def do_GET(self):
        if self.path.split("?", 1)[0] == "/login" and viewer_lock.pin_set(): return self._login_page()
        if self.path.startswith("/api/"): return self._api("GET")
        if VD and self.path.startswith("/data/") and self.path.split("?")[0].endswith(".json"):
            try: return self._data()
            except (BrokenPipeError, ConnectionResetError): return
        return super().do_GET()
    def do_HEAD(self):
        if self.path.startswith("/api/"): return self._err(405, "use GET")
        return super().do_HEAD()
    def do_PUT(self): return self._api("PUT") if self.path.startswith("/api/") else self._err(405, "method not allowed")
    def do_POST(self): return self._api("POST") if self.path.startswith("/api/") else self._err(405, "method not allowed")
    def do_DELETE(self): return self._api("DELETE") if self.path.startswith("/api/") else self._err(405, "method not allowed")

    # ---------- static with Range ----------
    def send_head(self):
        self._left = None  # handler is reused across keep-alive requests
        rng = self.headers.get("Range")
        path = self.translate_path(self.path)
        m = re.match(r"bytes=(\d*)-(\d*)$", rng.strip()) if rng else None
        if not m or not (m.group(1) or m.group(2)) or not os.path.isfile(path):
            return super().send_head()
        size = os.path.getsize(path)
        a = int(m.group(1)) if m.group(1) else max(0, size - int(m.group(2)))
        b = int(m.group(2)) if m.group(1) and m.group(2) else size - 1
        b = min(b, size - 1)
        if a >= size or a > b:
            self.send_response(416)
            self.send_header("Content-Range", f"bytes */{size}")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return None
        f = open(path, "rb"); f.seek(a)
        self.send_response(206)
        self.send_header("Content-Type", self.guess_type(path))
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Range", f"bytes {a}-{b}/{size}")
        self.send_header("Content-Length", str(b - a + 1))
        self.end_headers()
        self._left = b - a + 1
        return f

    def copyfile(self, src, dst):
        left = getattr(self, "_left", None)
        if left is None: return super().copyfile(src, dst)
        while left > 0:
            chunk = src.read(min(1 << 16, left))
            if not chunk: break
            try: dst.write(chunk)
            except (BrokenPipeError, ConnectionResetError): break
            left -= len(chunk)


